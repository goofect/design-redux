# vscode
.vscode 

# Intellij
*.iml
.idea

# npm
node_modules

# Built by build.mjs, from src/ and styles/; releases carry them, the repository doesn't.
/main.js
/styles.css

# Scratch copies the test suites write and delete as they run
tests/_*.js

# Exclude sourcemaps
*.map

# obsidian
data.json

# Exclude macOS Finder (System Explorer) View States
.DS_Store

# Real-Obsidian test downloads, logs and screenshots
.obsidian-cache
logs
ci-output

# What tests/map.js keeps by content hash, and task checkpoints
.claude-cache

# The graphify knowledge graph, built locally (/graphify .)
graphify-out

# Personal Claude Code settings; the shared ones are .claude/settings.json
.claude/settings.local.json

# Secrets and local environment
.env
.env.*
